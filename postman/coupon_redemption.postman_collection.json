    {
      "name": "Redeem",
      "item": [
        {
          "name": "Redeem - success (STANDARD, with amount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
