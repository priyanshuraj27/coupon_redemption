            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"code\": \"{{stackCode}}\",\n    \"max_redemptions\": 50,\n    \"discount_percent\": 20,\n    \"expires_at\": \"{{futureDate}}\",\n    \"type\": \"STACKABLE\"\n  },\n  {\n    \"code\": \"{{limitedCode}}\",\n    \"max_redemptions\": 2,\n    \"discount_percent\": 15,\n    \"expires_at\": \"{{futureDate}}\",\n    \"type\": \"STACKABLE\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons",
              "host": [
                "{{baseUrl}}"
