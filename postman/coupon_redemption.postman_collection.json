            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{stdCode}}\",\n  \"customer_id\": \"{{alice}}\",\n  \"order_id\": \"ord-{{runId}}-1\",\n  \"amount\": 200\n}",
