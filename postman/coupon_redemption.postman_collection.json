{
  "info": {
    "name": "Coupon Redemption Service",
    "description": "All endpoints of the coupon redemption service.\n\nRun the whole collection top to bottom with the Collection Runner: requests depend on earlier ones (coupons are created first, then redeemed, then orders cancelled) and every request has test assertions.\n\nStart with \"Start new test run\" - it generates fresh codes/customers/order ids so the collection can be re-run.\n\nSet baseUrl (collection variable) if the server is not on http://localhost:3000. MongoDB must be a replica set.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Start new test run (health check)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString(36).toUpperCase();",
              "const v = pm.collectionVariables;",
              "v.set('runId', runId);",
              "v.set('stdCode', 'STD_' + runId);         // STANDARD, 100 uses",
              "v.set('stackCode', 'STACK_' + runId);     // STACKABLE, 50 uses",
              "v.set('limitedCode', 'LIMITED_' + runId); // STACKABLE, only 2 uses",
              "v.set('expCode', 'EXP_' + runId);         // expires a few seconds after creation",
              "v.set('partialCode', 'PARTIAL_' + runId);",
              "v.set('alice', 'alice-' + runId);",
              "v.set('bob', 'bob-' + runId);",
              "v.set('carol', 'carol-' + runId);",
              "v.set('futureDate', new Date(Date.now() + 30 * 864e5).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Run this first. Checks the server is up and generates fresh coupon codes, customers and order ids (via runId) so the whole collection can be run again without \"already exists\" conflicts from a previous run."
      },
      "response": []
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "Create single coupon (STANDARD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
                  "  const c = pm.response.json().data.created[0];",
                  "  pm.test('code stored uppercase', () => pm.expect(c.code).to.eql(pm.collectionVariables.get('stdCode')));",
                  "  pm.test('redemption_count starts at 0', () => pm.expect(c.redemption_count).to.eql(0));",
                  "  pm.test('used_by starts empty', () => pm.expect(c.used_by).to.eql([]));",
                  "  pm.test('created_by is null without auth', () => pm.expect(c.created_by).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{stdCode}}\",\n  \"max_redemptions\": 100,\n  \"discount_percent\": 10,\n  \"expires_at\": \"{{futureDate}}\",\n  \"type\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons"
              ]
            },
            "description": "Body can be a single object, an array, or { \"coupons\": [...] }. STANDARD = once per customer."
          },
          "response": []
        },
        {
          "name": "Create multiple coupons (batch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
                  "  pm.test('2 created, 0 failed', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.created).to.have.length(2);",
                  "    pm.expect(d.failed).to.have.length(0);",
                  "  });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
